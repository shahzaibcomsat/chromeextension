{
  "manifest_version": 3,
  "name": "Shahzaib SEO",
  "version": "1.0.0",
  "description": "Inspect on-page SEO, structured data, links and technical signals. Local audits with optional user-configured integrations.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {"default_title": "Audit this page with Shahzaib SEO", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "background": {"service_worker": "src/background.js", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
